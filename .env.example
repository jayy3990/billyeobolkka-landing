# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요. (.env 는 git에 올라가지 않아요)
# 로컬에서는 작업 폴더 맨 위(my-startup/.env)의 값을 자동으로 읽어요. 배포(Vercel)에서는 환경변수로 등록해야 해요.

# Resend · resend.com > API Keys (서버에서만 읽어요. 웹페이지 코드에 넣지 마세요)
RESEND_API_KEY=

# 보내는 사람. 도메인 인증 전에는 아래 시험용 주소를 그대로 쓰세요.
# (시험용 주소는 Resend 가입 메일 주소로만 보낼 수 있어요)
CONTACT_FROM_EMAIL=빌려볼까 <onboarding@resend.dev>

# 홈페이지 문의 메일을 받을 내 이메일 (도메인 인증 전에는 Resend 가입 메일 주소여야 해요)
CONTACT_TO_EMAIL=

# ── 회원 인증 (회원가입·로그인·비밀번호 재설정) ─────────────────────
# 우리 사이트 주소. 메일 링크와 요청 출처 확인에 써요. 끝에 / 없이, 로컬에서는 http://localhost:3000
SITE_URL=

# Supabase · Project Settings > API. 공개(publishable/anon) 키만 쓰세요.
# ⚠ service_role / secret 키는 이 프로젝트에 필요 없어요. 절대 넣지 마세요.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudflare Turnstile (사람인지 확인) · dash.cloudflare.com > Turnstile
# 사이트 키: 브라우저에 공개돼도 되는 키 (페이지 빌드 때 config.js로 들어가요)
TURNSTILE_SITE_KEY=
# 시크릿 키: 서버(사전신청 메일 함수)에서만 써요. Supabase 대시보드(CAPTCHA 설정)에도 같은 값을 따로 넣어요.
TURNSTILE_SECRET_KEY=
